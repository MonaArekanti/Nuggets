diff --git a/frontend/task/src/api.js b/frontend/task/src/api.js
new file mode 100644
index 0000000..0ea0e0b
--- /dev/null
+++ b/frontend/task/src/api.js
@@ -0,0 +1,31 @@
+// Single place for API config. Adjust BASE / key names here if yours differ.
+const BASE = import.meta.env.VITE_API_URL || "http://localhost:5000/api";
+
+export const getToken = () => localStorage.getItem("token");
+export const getUser = () => {
+  try { return JSON.parse(localStorage.getItem("user")); } catch { return null; }
+};
+export const setSession = ({ token, user }) => {
+  if (token) localStorage.setItem("token", token);
+  if (user) localStorage.setItem("user", JSON.stringify(user));
+};
+export const clearSession = () => {
+  localStorage.removeItem("token");
+  localStorage.removeItem("user");
+};
+
+export async function api(path, { method = "GET", body } = {}) {
+  const token = getToken();
+  const res = await fetch(BASE + path, {
+    method,
+    headers: { "Content-Type": "application/json", ...(token && { Authorization: `Bearer ${token}` }) },
+    body: body ? JSON.stringify(body) : undefined,
+  });
+  const data = await res.json().catch(() => ({}));
+  if (!res.ok) {
+    const err = new Error(data.message || data.error || "Something went wrong. Please try again.");
+    err.status = res.status;
+    throw err;
+  }
+  return data.data !== undefined ? data.data : data; // backend wraps payloads as { success, data }
+}
diff --git a/frontend/task/src/components/ConfirmDialog.jsx b/frontend/task/src/components/ConfirmDialog.jsx
